import { Button, ListView, CheckBox } from "std-widgets.slint";

export struct TaskItem {
    title: string,
    checked: bool,
}

// component AppCheckBox inherits CheckBox {

// }

component AppListView inherits ListView {
    in-out property <[string]> items: ["Get started"];
    in-out property <[TaskItem]> task_items;


    // for item in items: CheckBox {
    //     text: item;
    // }
    
    for task_item in task_items: CheckBox {
        text: task_item.title;
        checked: task_item.checked;
        toggled => {
            task_item.checked = self.checked;
        }
    }
}

export component AppWindow inherits Window {
    in-out property <[string]> items <=> app_listview.items;
    in-out property <[TaskItem]> task_items <=> app_listview.task_items;
    in-out property <string> input_text;
    callback request-add-item();
    callback request-remove-item();


    VerticalLayout {
        TextInput {
           text <=> input_text;
        }

        HorizontalLayout {
            Button {
                text: "Add";
                clicked => {
                    root.request-add-item();
                }
            }

            Button {
                text: "Remove";
                clicked => {
                    root.request-remove-item();
                }
            }
        }

        app_listview := AppListView {}
    }
}
